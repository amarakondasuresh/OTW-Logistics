# Razorpay TEST/SANDBOX credentials only for initial testing.
# Never commit a real secret to GitHub or put it in index.html/app.js.
PORT=8080
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me
# Create one Razorpay Subscription Plan per frequency in the Razorpay dashboard/API.
RAZORPAY_PLAN_DAILY_ID=plan_test_daily_xxx
RAZORPAY_PLAN_WEEKLY_ID=plan_test_weekly_xxx
RAZORPAY_PLAN_MONTHLY_ID=plan_test_monthly_xxx
# Set this only after the backend is deployed over HTTPS and verified.
ALLOWED_ORIGIN=http://localhost:8080

# Vendor and Franchise Portal > Settings > Helpline / Support messages go to SUPPORT_EMAIL (also shown in both portals
# and used as the reply address of emails to applicants).
# Sending needs a Gmail App Password (Google Account > Security > 2-Step Verification > App passwords).
# It is used for the support emails and the admin "Forgot password" reset emails. It is not any admin's own Gmail password.
# Never share or commit the real .env file.
SUPPORT_EMAIL=supportontheway@gmail.com
# GMAIL_USER sends every email (applicants, admin resets, support). GMAIL_APP_PASSWORD must be an App Password of THAT account.
GMAIL_USER=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=replace_with_16_character_gmail_app_password
# Using a different mail provider instead of Gmail? Fill these in (they take priority over the Gmail settings):
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=support@example.com
# SMTP_PASS=your_smtp_password

# The admin who can manage the other admins (Settings > Admin Accounts). Leave empty to use the earliest-created admin.
# SUPER_ADMIN_EMAIL=balajinaik5069@gmail.com

# ---- Going online ----
# Public address of the site, used in the login emails sent to accepted partners and in admin password-reset links.
# Admins reading the reset email on a phone need an address the phone can open (for example http://192.168.1.20:8080 on your Wi-Fi, or your domain).
# PUBLIC_URL=https://www.your-domain.com
# Set to true when running behind an HTTPS proxy/host (Render, Railway, Nginx...) so sign-in cookies are marked Secure.
# TRUST_PROXY=true
# Extra host names this server may be reached at (comma separated), besides localhost, IP addresses and PUBLIC_URL.
# ALLOWED_HOSTS=www.your-domain.com,your-app.onrender.com

# ---- Google Drive payment sync (Admin Portal > Payments > Google Drive) ----
# Create an OAuth client (Google Cloud Console > APIs & Services > Credentials > OAuth client ID, type "Web application").
# Add the redirect URI shown below to it, and enable the Google Drive API for the project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Defaults to PUBLIC_URL (or this server's address) + /api/admin/drive/callback.
# GOOGLE_REDIRECT_URI=https://www.your-domain.com/api/admin/drive/callback
# Any long random text, at least 16 characters. It encrypts the stored Google sign-in. Changing it disconnects Google Drive.
DRIVE_TOKEN_SECRET=
# How often the server checks the chosen folder for changed Excel files (minutes, 5 or more). Sync Now is always available.
DRIVE_SYNC_MINUTES=15


# Helpline / Support (Admin Portal > Support Management)
# Every new Vendor / Franchise support request is emailed to SUPPORT_EMAIL, with a copy to ADMIN_EMAIL.
# Leave ADMIN_EMAIL empty to copy every active admin account's registered email instead.
# Also receives an email for every new Franchise / Vendor application submitted on the website, with the
# application ID, applicant name, type, mobile, submission time and a link to the Admin Dashboard.
# Several addresses can be listed separated by commas. Leave empty to use every active admin's email.
# ADMIN_EMAIL=admin@example.com

# Incoming customer email (support Gmail, read through the Gmail API). Run: node gmail-authorize.js
# Until these are set, customer emails sent to the support address are not read.
# GMAIL_OAUTH_CLIENT_ID=
# GMAIL_OAUTH_CLIENT_SECRET=
# GMAIL_OAUTH_REFRESH_TOKEN=
